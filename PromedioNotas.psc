Algoritmo PromedioNotas
	
	Definir nota1 Como Real
	Definir nota2 Como Real
	Definir nota3 Como Real
	
	Escribir "Dame la nota 1, papi"
	Leer nota1
	
	Escribir "Dame la nota 2, que rico"
	Leer nota2
	
	Escribir "Dame la nota 3, daddy"
	Leer nota3
	
	Escribir "Tu promedio es " + ConvertirATexto((nota1+nota2+nota3)/3) + " UwU"
FinAlgoritmo
